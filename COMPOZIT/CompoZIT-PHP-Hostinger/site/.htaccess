# =========================================================================
#  CompoZ'IT - regles Apache pour un hebergement mutualise (Hostinger)
# =========================================================================
#  Ce fichier est indispensable : il protege les fichiers sensibles et
#  force le HTTPS. Verifie qu'il a bien ete envoye avec le reste du site
#  (les clients FTP masquent parfois les fichiers commencant par un point).
# =========================================================================

# --- Pas de listing des dossiers ---
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dossier de travail : sessions PHP + jetons d'API. Jamais accessible.
    RewriteRule ^tmp/ - [F,L]

    # Redirection http -> https (a conserver une fois le certificat SSL actif
    # dans hPanel -> Securite -> SSL).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Fichiers sensibles jamais telechargeables ---
<FilesMatch "\.(sql|bak|old|orig|log|ini|toml)$">
    Require all denied
</FilesMatch>

# --- config.local.php : identifiants MySQL et cles d'API ---
#     (le blocage ne concerne que les requetes HTTP : PHP continue de
#      l'inclure normalement)
<Files "config.local.php">
    Require all denied
</Files>

# --- config.php : fichier technique, jamais appele directement ---
<Files "config.php">
    Require all denied
</Files>

# --- En-tetes de securite ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
